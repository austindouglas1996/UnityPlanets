// === MarchingCubes.compute ===
// This compute shader will generate triangles using Marching Cubes.

#pragma kernel March

#include "Includes/TriangleTable.hlsl"

#define THREADS_X 4
#define THREADS_Y 4
#define THREADS_Z 4

struct Triangle
{
    int coordX, coordY, coordZ;
    float3 a, b, c;
    float4 colorA, colorB, colorC;
    float3 normal;
    float2 uvA, uvB, uvC;
};

struct BiomeData
{
    float minSurface;
    float maxSurface;
    float4 gradientStart;
    float4 gradientEnd;
};

struct ChunkInput
{
    int coordX;
    int coordY;
    int coordZ;
    float baseX;
    float baseY;
    float baseZ;
    int stepSize;
};

StructuredBuffer<ChunkInput> ChunkInputs;

StructuredBuffer<float> DensityMap;
AppendStructuredBuffer<Triangle> TriangleBuffer;

StructuredBuffer<BiomeData> BiomeColors;
int _BiomeCount;

int _SizeX;
int _SizeY;
int _SizeZ;
float _IsoLevel;

float4 GetColorForHeight(float height)
{
    BiomeData current = BiomeColors[_BiomeCount - 1];
    BiomeData next = current;
    bool hasUpper = false;

    for (int i = 0; i < _BiomeCount - 1; i++)
    {
        if (height >= BiomeColors[i].minSurface && height < BiomeColors[i + 1].minSurface)
        {
            current = BiomeColors[i];

            if (i + 1 < _BiomeCount)
            {
                next = BiomeColors[i + 1];
                hasUpper = true;
            }
            break;
        }
    }

    // Normalize height within current biome gradient
    float tCurrent = saturate((height - current.minSurface) / max(current.maxSurface - current.minSurface, 0.0001));
    float4 baseColor = lerp(current.gradientStart, current.gradientEnd, tCurrent);

    if (hasUpper)
    {
        // Normalize height within next biome gradient
        float tNext = saturate((height - next.minSurface) / max(next.maxSurface - next.minSurface, 0.0001));
        float4 nextColor = lerp(next.gradientStart, next.gradientEnd, tNext);

        // Blend between biomes across boundary
        float blendAmount = saturate((height - current.maxSurface) / max(next.minSurface - current.maxSurface, 0.0001));
        return lerp(baseColor, nextColor, blendAmount);
    }

    return baseColor;
}

float2 GetUV(float3 worldPos)
{
    // Planar projection: good for terrain-style meshes
    return worldPos.xz * 0.05; // Scale as needed
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void March(uint3 localID : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    uint chunkIndex = groupId.x;
    ChunkInput chunk = ChunkInputs[chunkIndex];

    uint x = localID.x;
    uint y = localID.y;
    uint z = localID.z;

    // Skip if on edge (we can't build a cube here)
    if (x >= _SizeX - 1 || y >= _SizeY - 1 || z >= _SizeZ - 1)
        return;

    float corner[8];
    float3 cornerPos[8];
    int cubeIndex = 0;

    int chunkVoxelCount = _SizeX * _SizeY * _SizeZ;
    int chunkOffset = chunkIndex * chunkVoxelCount;

    // Sample all 8 corners of the cube
    for (int i = 0; i < 8; i++)
    {
        int3 offset = CornerOffsets[i];
        int3 pos = int3(x + offset.x, y + offset.y, z + offset.z);

        // Bounds check (only needed for dynamic chunk sizing)
        if (pos.x >= _SizeX || pos.y >= _SizeY || pos.z >= _SizeZ)
            return;

        int localIndex = pos.x + pos.y * _SizeX + pos.z * _SizeX * _SizeY;
        int index = chunkOffset + localIndex;

        corner[i] = DensityMap[index];
        cornerPos[i] = float3(pos) * chunk.stepSize;

        if (corner[i] > _IsoLevel)
            cubeIndex |= (1 << i);
    }

    if (cubeIndex == 0 || cubeIndex == 255)
        return;

    // Emit triangles
    for (int i = 0; TriangleTable[cubeIndex][i] != -1; i += 3)
    {
        int a = TriangleTable[cubeIndex][i + 0];
        int b = TriangleTable[cubeIndex][i + 1];
        int c = TriangleTable[cubeIndex][i + 2];

        int2 edge0 = EdgeConnections[a];
        int2 edge1 = EdgeConnections[b];
        int2 edge2 = EdgeConnections[c];

        float3 v0 = lerp(cornerPos[edge0.x], cornerPos[edge0.y],
                         (corner[edge0.x] - _IsoLevel) / (corner[edge0.x] - corner[edge0.y] + 0.0001));
        
        float3 v1 = lerp(cornerPos[edge1.x], cornerPos[edge1.y],
                         (corner[edge1.x] - _IsoLevel) / (corner[edge1.x] - corner[edge1.y] + 0.0001));

        float3 v2 = lerp(cornerPos[edge2.x], cornerPos[edge2.y],
                         (corner[edge2.x] - _IsoLevel) / (corner[edge2.x] - corner[edge2.y] + 0.0001));

        float3 worldA = v0 + float3(chunk.baseX, chunk.baseY, chunk.baseZ);
        float3 worldB = v1 + float3(chunk.baseX, chunk.baseY, chunk.baseZ);
        float3 worldC = v2 + float3(chunk.baseX, chunk.baseY, chunk.baseZ);

        Triangle tri;
        tri.coordX = chunk.coordX;
        tri.coordY = chunk.coordY;
        tri.coordZ = chunk.coordZ;

        tri.a = v0;
        tri.b = v1;
        tri.c = v2;

        tri.colorA = GetColorForHeight(worldA.y);
        tri.colorB = GetColorForHeight(worldB.y);
        tri.colorC = GetColorForHeight(worldC.y);

        tri.normal = normalize(cross(v1 - v0, v2 - v0));

        tri.uvA = GetUV(worldA);
        tri.uvB = GetUV(worldB);
        tri.uvC = GetUV(worldC);

        TriangleBuffer.Append(tri);
    }
}
