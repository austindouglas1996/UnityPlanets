// === MarchingCubes.compute ===
// This compute shader will generate triangles using Marching Cubes.

#pragma kernel March
#pragma kernel FinalizeArgs

#include "Includes/TriangleTable.hlsl"
#include "Includes/Triangle.hlsl"
#include "Includes/ChunkInput.hlsl"
#include "Includes/Biomes.hlsl"

StructuredBuffer<ChunkInput> ChunkInputs;
StructuredBuffer<float> DensityMap;
AppendStructuredBuffer<Triangle> TriangleBuffer;
RWStructuredBuffer<uint> ArgsBuffer;

int _SizeX;
int _SizeY;
int _SizeZ;
float _IsoLevel;

float2 GetUV(float3 worldPos)
{
    // Planar projection: good for terrain-style meshes
    return worldPos.xz * 0.05;
}

[numthreads(1, 1, 1)]
void March(uint3 id : SV_DispatchThreadID)
{
    int chunkSize = _SizeX - 1;
    int chunkVoxelSize = _SizeX * _SizeY * _SizeZ;

    ChunkAccessInfo access = GetChunkAccess(id, _SizeX - 1, _SizeY - 1, _SizeZ - 1, ChunkInputs);

    if (access.mapIndex < 0)
        return;

    int cubeIndex = 0;
    float corner[8];
    float3 cornerPos[8];

    for (int i = 0; i < 8; i++)
    {
        int3 offset = CornerOffsets[i];
        int3 pos = access.voxelCoord + offset;

        // Check bounds
        if (any(pos < 0) || pos.x >= _SizeX || pos.y >= _SizeY || pos.z >= _SizeZ)
            return;

        int localIndex = pos.x + pos.y * _SizeX + pos.z * _SizeX * _SizeY;
        int fullIndex = access.chunkIndex * chunkVoxelSize + localIndex;

        corner[i] = DensityMap[fullIndex];
        cornerPos[i] = float3(pos) * access.chunk.stepSize;

        if (corner[i] > _IsoLevel)
            cubeIndex |= (1 << i);
    }

    if (cubeIndex == 0 || cubeIndex == 255)
        return;

    for (int i = 0; TriangleTable[cubeIndex][i] != -1; i += 3)
    {
        int a = TriangleTable[cubeIndex][i + 0];
        int b = TriangleTable[cubeIndex][i + 1];
        int c = TriangleTable[cubeIndex][i + 2];

        int2 edge0 = EdgeConnections[a];
        int2 edge1 = EdgeConnections[b];
        int2 edge2 = EdgeConnections[c];

        float3 v0 = lerp(cornerPos[edge0.x], cornerPos[edge0.y],
                         (corner[edge0.x] - _IsoLevel) / (corner[edge0.x] - corner[edge0.y] + 0.0001));
        float3 v1 = lerp(cornerPos[edge1.x], cornerPos[edge1.y],
                         (corner[edge1.x] - _IsoLevel) / (corner[edge1.x] - corner[edge1.y] + 0.0001));
        float3 v2 = lerp(cornerPos[edge2.x], cornerPos[edge2.y],
                         (corner[edge2.x] - _IsoLevel) / (corner[edge2.x] - corner[edge2.y] + 0.0001));

        float3 worldA = v0 + access.chunk.WorldPos;
        float3 worldB = v1 + access.chunk.WorldPos;
        float3 worldC = v2 + access.chunk.WorldPos;

        Triangle tri;
        
        tri.a = worldA;
        tri.b = worldB;
        tri.c = worldC;
        
        tri.colorA = GetColorForHeight(worldA.y);
        tri.colorB = GetColorForHeight(worldB.y);
        tri.colorC = GetColorForHeight(worldC.y);
        
        TriangleBuffer.Append(tri);
    }
}

[numthreads(1, 1, 1)]
void FinalizeArgs(uint3 id : SV_DispatchThreadID)
{
    // ArgsBuffer[0] is the number of triangles from CopyCount
    // Convert to vertex count by multiplying by 3
    ArgsBuffer[0] *= 3;

    // Set instance count to 1
    ArgsBuffer[1] = 1;
}