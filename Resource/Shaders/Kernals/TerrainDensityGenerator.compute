#pragma kernel GenerateBatch
#pragma kernel GetSurfaceMaskChecks

#include "../Lib/PerlinNoise.hlsl"
#include "../Includes/TriangleTable.hlsl"
#include "../Types/ChunkDispatchKey.hlsl"
#include "../Types/TerrainDensityOptions.hlsl"

/* Inputs */
StructuredBuffer<ChunkDispatchKey> ChunkInputs;
StructuredBuffer<TerrainDensityOptions> DensityOptions;

/* Inputs Special */
StructuredBuffer<PlanetDensityOptions> PlanetOptions;

/* Outputs */
RWStructuredBuffer<uint> SurfaceMask;
RWStructuredBuffer<float> DensityMap;

// Helper parameter used in GetSurfaceMaskChecks to tell if the X exceeds our limit.
int _ChunkInputCount;

int GetOctaves(int lod)
{
    switch (lod)
    {
        case 0:
            return 6;
        case 1:
            return 4;
        case 2:
            return 2;
        default:
            return 1;
    }
}

float Sanitize(float v)
{
    return (isnan(v) || isinf(v)) ? 0.0 : v;
}

// Retrieve the density value for a given position.
float GetDensityValue(TerrainDensityOptions options, float worldX, float worldY, float worldZ, int lod)
{
    // Decide noise sample coordinates based on variant
    float3 samplePos3D;

    if (options.SubVariant == SUBVARIANT_PLANET)
    {
        // For planet, use normalized direction from center for consistent wrapping
        float3 wp = float3(worldX, worldY, worldZ);
        float3 dir = normalize(wp - PlanetOptions[0].Center);

        // Offset so noise moves with BaseOffset/DetailOffset in 3D
        samplePos3D = dir * PlanetOptions[0].Radius;
    }
    else
    {
        // For landmass (and cave for now), just use flat XZ mapping
        samplePos3D = float3(worldX, 0.0, worldZ);
    }

    int octaves = GetOctaves(lod);

    // === Base continent layer ===
    float3 basePos = (samplePos3D + float3(options.BaseOffset, 0)) * options.BaseFreq;
    float baseNoise = fbm3D(basePos, 2); // using 3D even for landmass so system is future-proof
    baseNoise = smoothstep(0.0, 1.0, (baseNoise + 1.0) * 0.5);

    // === Mid/large-scale detail ===
    float3 detailPos = (samplePos3D + float3(options.DetailOffset, 0)) * options.DetailFreq;
    float detailNoise = fbm3D(detailPos, (lod == 1 ? 6 : octaves));

    // === Flatness mask ===
    float3 flatPos = (samplePos3D + float3(options.FlatMaskOffset, 0)) * options.FlatMaskFreq;
    float flatNoise = fbm3D(flatPos, 3);
    flatNoise = saturate((flatNoise + 1.0) * 0.5);
    flatNoise = pow(saturate(1.0 - flatNoise), options.FlatMaskPower);

    // === Combine height contributions ===
    float rawHeight =
        baseNoise * options.BaseGain +
        detailNoise * options.DetailGain * flatNoise;

    float heightScale = max(options.BaseGain, 0.0001);
    float normalized = rawHeight / heightScale;
    float finalHeight = normalized * options.ElevationScale;

    return Sanitize(finalHeight);
}


float GetLandMassValue(TerrainDensityOptions options, float worldX, float worldY, float worldZ, int lod)
{
    float v = GetDensityValue(options, worldX, worldY, worldZ, lod);
    float result = -(worldY - v);
    
    return Sanitize(result);

}

float GetPlanetValue(TerrainDensityOptions options, float worldX, float worldY, float worldZ, int lod)
{
    float elev = GetDensityValue(options, worldX, worldY, worldZ, lod);
    float dist = length(float3(worldX, worldY, worldZ) - PlanetOptions[0].Center);
    return (PlanetOptions[0].Radius + elev) - dist; // Positive inside sphere
}

// Generates the density data for a marching cube algorithm.
[numthreads(4,4,4)]
void GenerateBatch(uint3 id : SV_DispatchThreadID)
{
    TerrainDensityOptions mOptions = DensityOptions[0];
    int chunkLogicalSize = mOptions.ChunkSize + 1;
    
    ChunkDispatchKeyInfo info = GetChunkAccess(id, chunkLogicalSize, chunkLogicalSize, chunkLogicalSize, ChunkInputs);
    if (info.mapIndex < 0)
        return;
    
    float3 worldPos = info.WorldPos;

    if (mOptions.SubVariant == 0)
    {
        DensityMap[info.mapIndex] = GetLandMassValue(mOptions, worldPos.x, worldPos.y, worldPos.z, info.chunk.LodIndex);
    }
    else if (mOptions.SubVariant == 1)
    {
        DensityMap[info.mapIndex] = GetPlanetValue(mOptions, worldPos.x, worldPos.y, worldPos.z, info.chunk.LodIndex);
    }
}

    // Shared flags so any thread can “trip” the result
groupshared uint gHasAbove;
groupshared uint gHasBelow;

// One group per chunk, 4x4x4 = 64 threads per group
[numthreads(4, 4, 4)]
void GetSurfaceMaskChecks(uint3 groupId : SV_GroupID,
                          uint3 tid : SV_GroupThreadID,
                          uint groupIdx : SV_GroupIndex)
{
    uint index = groupId.x; // 1D group grid: (batchSize,1,1)
    if (index >= _ChunkInputCount)
        return;

    // Load once per group (uniform)
    ChunkDispatchKey chunk = ChunkInputs[index];
    TerrainDensityOptions mOptions = DensityOptions[0];

    // Precompute invariants
    const float iso = mOptions.ISOLevel;
    const int baseSize = mOptions.ChunkSize + 3; // your pad; keep if you need it
    const int step = (1 << chunk.LodIndex);

    const float3 origin = ToWorld(chunk);

    if (groupIdx == 0)
    {
        gHasAbove = 0;
        gHasBelow = 0;
    }
    GroupMemoryBarrierWithGroupSync();

    // Partition the 3D region across 4x4x4 threads
    // Each thread processes a strided subset.
    for (int x = tid.x; x < baseSize; x += 4)
    {
        // Early exit: if another thread already proved mixed signs, stop
        if (gHasAbove & gHasBelow)
            break;

        const float wx = origin.x + x * step;

        for (int y = tid.y; y < baseSize; y += 4)
        {
            if (gHasAbove & gHasBelow)
                break;

            const float wy = origin.y + y * step;

            for (int z = tid.z; z < baseSize; z += 4)
            {
                if (gHasAbove & gHasBelow)
                    break;

                const float wz = origin.z + z * step;

                // Uniform branch on subvariant is fine; compiler will keep it outside inner loop
                float v;
                if (mOptions.SubVariant == 0)
                    v = GetLandMassValue(mOptions, wx, wy, wz, chunk.LodIndex);
                else /* SubVariant == 1 */
                    v = GetPlanetValue(mOptions, wx, wy, wz, chunk.LodIndex);

                // Set flags (branchless) and combine with atomics
                // (bool → uint: (v >= iso) ? 1 : 0)
                InterlockedOr(gHasAbove, (uint) (v >= iso));
                InterlockedOr(gHasBelow, (uint) (v < iso));

                // Optional super-early exit: if this thread discovered both, hint others
                if ((gHasAbove & gHasBelow) != 0)
                    break;
            }
        }
    }

    GroupMemoryBarrierWithGroupSync();

    // One thread writes the mask
    if (groupIdx == 0)
    {
        SurfaceMask[index] = (gHasAbove & gHasBelow) ? 1u : 0u;
    }
}
