#pragma only_renderers d3d11
#pragma target 5.0

#pragma kernel GenerateDensityMap
#pragma kernel GenerateSurfaceMask
#pragma kernel RunMarchingCubes
#pragma kernel RunDetailsPass
#pragma kernel PrepareDrawArgs

#include "../ChunkFunctions.hlsl"
#include "../Lib/PerlinNoise.hlsl"
#include "../Includes/TriangleTable.hlsl"
#include "../Algo/ChunkMarchingCubes.hlsl"
#include "../Algo/SimpleDensityGen.hlsl"
#include "../Biomes/BiomeSampler.hlsl"

/* Inputs */
StructuredBuffer<ChunkDispatchKey> ChunkInputs;
RWStructuredBuffer<float> DensityMap;

/* Outputs */
RWStructuredBuffer<uint> SurfaceMask;

/* March Kernel */
AppendStructuredBuffer<TriangleData> TriangleBuffer;
AppendStructuredBuffer<ChunkDetailData> InitialDetailBuffer;

/* Detail Kernel */
StructuredBuffer<TriangleData> DetailTriangles;
RWStructuredBuffer<ChunkDetailData> DetailBuffer;

/* Args Kernel */
RWStructuredBuffer<uint> ArgsBuffer;

// Shared flags so any thread can “trip” the result in GetSurfaceData.
groupshared uint gHasAbove;
groupshared uint gHasBelow;

[numthreads(4, 4, 4)]
void GenerateDensityMap(uint3 id : SV_DispatchThreadID)
{
    ChunkDispatchKeyInfo info = GetChunkAccessSamples(id, ChunkInputs);
    if (info.SampleIndex < 0)
        return;
    
    DensityMap[info.SampleIndex] = GenerateNoiseValue(info.WorldPos, info.chunk.LodIndex);
}

// One group per chunk, 4x4x4 = 64 threads per group
[numthreads(4, 4, 4)]
void GenerateSurfaceMask(uint3 groupId : SV_GroupID, uint3 tid : SV_GroupThreadID, uint groupIdx : SV_GroupIndex)
{
    // Load once per group (uniform)
    ChunkDispatchKey chunk = ChunkInputs[groupId.x];

    // Precompute invariants
    const float iso = ISOLevel;
    const int baseSize = GetSamplesPerAxis();
    const int step = GetCubeSizeStep(chunk.LodIndex);

    const float3 origin = ToWorld(chunk.CoordPos, chunk.LodIndex);

    if (groupIdx == 0)
    {
        gHasAbove = 0;
        gHasBelow = 0;
    }
    GroupMemoryBarrierWithGroupSync();

    // Partition the 3D region across 4x4x4 threads
    // Each thread processes a strided subset.
    for (int x = tid.x; x < baseSize; x += 4)
    {
        // Early exit: if another thread already proved mixed signs, stop
        if (gHasAbove & gHasBelow)
            break;

        const float wx = origin.x + x * step;

        for (int y = tid.y; y < baseSize; y += 4)
        {
            if (gHasAbove & gHasBelow)
                break;

            const float wy = origin.y + y * step;

            for (int z = tid.z; z < baseSize; z += 4)
            {
                if (gHasAbove & gHasBelow)
                    break;

                const float wz = origin.z + z * step;

                // Uniform branch on subvariant is fine; compiler will keep it outside inner loop
                float v = GenerateNoiseValue(float3(wx, wy, wz), chunk.LodIndex);

                // Set flags (branchless) and combine with atomics
                // (bool → uint: (v >= iso) ? 1 : 0)
                InterlockedOr(gHasAbove, (uint) (v >= iso));
                InterlockedOr(gHasBelow, (uint) (v < iso));

                // Optional super-early exit: if this thread discovered both, hint others
                if ((gHasAbove & gHasBelow) != 0)
                    break;
            }
        }
    }

    GroupMemoryBarrierWithGroupSync();

    // One thread writes the mask
    if (groupIdx == 0)
    {
        SurfaceMask[groupId.x] = (gHasAbove & gHasBelow) ? 1u : 0u;
    }
}

// MarchingCubesPass
// Main meshing kernel. Reads voxel density data for a given chunk, determines
// which edges of the cube intersect the ISO surface, and emits triangles
// according to the marching cubes lookup tables.
// 
// Each thread processes one cube in the chunk's voxel grid.
[numthreads(4, 4, 4)]
void RunMarchingCubes(uint3 id : SV_DispatchThreadID)
{
    ChunkDispatchKeyInfo access = GetChunkAccessCubes(id, ChunkInputs);
    if (access.KeyIndex < 0) 
        return;
    
    March(access, TriangleBuffer, DensityMap);
}

[numthreads(64, 1, 1)]
void RunDetailsPass(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;

    if (idx >= ArgsBuffer[0])
        return;

    TriangleData tri = DetailTriangles[idx];
    ChunkDetailData d = (ChunkDetailData)0;
    
    d.Biome = GetTriangleBiomePacked(tri, 6);

    DetailBuffer[idx] = d;
}

// PrepareIndirectDrawArgs
// Small kernel to finalize DrawMeshInstancedIndirect args after triangle
// generation. Multiplies triangle count by 3 to get vertex count and sets
// instance count to 1.
// 
// This is run after MarchingCubesPass and CopyCount to populate ArgsBuffer.
[numthreads(1, 1, 1)]
void PrepareDrawArgs(uint3 id : SV_DispatchThreadID)
{
    uint triCount;
    uint stride; // Dummy
    TriangleBuffer.GetDimensions(triCount, stride); // query append counter

    ArgsBuffer[0] = triCount * 3; // vertex count
    ArgsBuffer[1] = 1; // instance count
    ArgsBuffer[2] = 0; // start vertex
    ArgsBuffer[3] = 0; // start instance
    ArgsBuffer[4] = 0; // padding (if needed)
}