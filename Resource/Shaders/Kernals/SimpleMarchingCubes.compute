#pragma only_renderers d3d11
#pragma target 5.0

#pragma kernel ClearRange
#pragma kernel GenerateDensityMap
#pragma kernel GenerateSurfaceMask
#pragma kernel RunMarchingCubesPrePass
#pragma kernel RunMarchingCubes
#pragma kernel RunRepack
#pragma kernel RunRepackPrePass
#pragma kernel RunDetailsPass

#include "../ChunkFunctions.hlsl"
#include "../Algo/ChunkMarchingCubes.hlsl"
#include "../Algo/SimpleDensityGen.hlsl"
#include "../Biomes/BiomeSampler.hlsl"
#include "../ChunkColoring.hlsl"

uint Offset;
uint BatchSize;

/* Inputs */
RWStructuredBuffer<ChunkDispatchKey> ChunkInputs;
RWStructuredBuffer<float> DensityMap;


/* Outputs */
RWStructuredBuffer<uint> SurfaceMask;

/* March Kernel */
RWStructuredBuffer<uint> TriangleCount;
RWStructuredBuffer<uint> TriangleCursor;
RWStructuredBuffer<TriangleData> TriangleSourceBuffer;
RWStructuredBuffer<TriangleData> TriangleDestBuffer;

/* Helper */
RWStructuredBuffer<uint> BufferToClear;
uint ClearStart;
uint ClearLength;

/* Detail Kernel */
StructuredBuffer<TriangleData> DetailTriangles;
RWStructuredBuffer<ChunkDetailData> DetailBuffer;

/* Args Kernel */
RWStructuredBuffer<uint> ArgsBuffer;
RWStructuredBuffer<uint> Args1Buffer;

// Shared flags so any thread can “trip” the result in GetSurfaceData.
groupshared uint gHasAbove;
groupshared uint gHasBelow;

[numthreads(1, 1, 1)]
void ClearRange(uint id : SV_DispatchThreadID)
{
    int length = (ClearStart + ClearLength);
    for (int i = ClearStart; i < length; i++)
    {
        BufferToClear[i] = 0;
    }
}

[numthreads(4, 4, 4)]
void GenerateDensityMap(uint3 id : SV_DispatchThreadID)
{
    ChunkDispatchKeyInfo info = GetChunkAccessSamples(id, Offset, ChunkInputs);
    DensityMap[info.SampleIndex] = GenerateNoiseValue(info.WorldPos, info.chunk.LodIndex);
}

// One group per chunk, 4x4x4 = 64 threads per group
[numthreads(4, 4, 4)]
void GenerateSurfaceMask(uint3 groupId : SV_GroupID, uint3 tid : SV_GroupThreadID, uint groupIdx : SV_GroupIndex)
{
    // Load once per group (uniform)
    ChunkDispatchKey chunk = ChunkInputs[groupId.x];

    // Precompute invariants
    const float iso = ISOLevel;
    const int baseSize = GetSamplesPerAxis();
    const int step = GetCubeSizeStep(chunk.LodIndex);

    const float3 origin = ToWorld(chunk.CoordPos, chunk.LodIndex);

    if (groupIdx == 0)
    {
        gHasAbove = 0;
        gHasBelow = 0;
    }
    GroupMemoryBarrierWithGroupSync();

    // Partition the 3D region across 4x4x4 threads
    // Each thread processes a strided subset.
    const uint done = gHasAbove & gHasBelow;
    for (uint x = tid.x; x < baseSize && !done; x += 4)
    {
        const float wx = origin.x + x * step;

        for (uint y = tid.y; y < baseSize && !done; y += 4)
        {
            const float wy = origin.y + y * step;

            for (uint z = tid.z; z < baseSize && !done; z += 4)
            {
                const float wz = origin.z + z * step;

                // Uniform branch on subvariant is fine; compiler will keep it outside inner loop
                float v = GenerateNoiseValue(float3(wx, wy, wz), chunk.LodIndex);

                // Set flags (branchless) and combine with atomics
                // (bool → uint: (v >= iso) ? 1 : 0)
                InterlockedOr(gHasAbove, (uint) (v >= iso));
                InterlockedOr(gHasBelow, (uint) (v < iso));
            }
        }
    }

    GroupMemoryBarrierWithGroupSync();

    // One thread writes the mask
    if (groupIdx == 0)
    {
        SurfaceMask[groupId.x] = (gHasAbove & gHasBelow) ? 1u : 0u;
    }
}

[numthreads(4, 4, 4)]
void RunMarchingCubesPrePass(uint3 id : SV_DispatchThreadID)
{
    ChunkDispatchKeyInfo access = GetChunkAccessCubes(id, Offset, ChunkInputs);
    CountTriangles(access, TriangleCount, DensityMap);
}

// MarchingCubesPass
// Main meshing kernel. Reads voxel density data for a given chunk, determines
// which edges of the cube intersect the ISO surface, and emits triangles
// according to the marching cubes lookup tables.
// 
// Each thread processes one cube in the chunk's voxel grid.
[numthreads(4, 4, 4)]
void RunMarchingCubes(uint3 id : SV_DispatchThreadID)
{
    ChunkDispatchKeyInfo access = GetChunkAccessCubes(id, Offset, ChunkInputs);
    March(access, TriangleCursor, TriangleSourceBuffer, DensityMap);
}

[numthreads(1, 1, 1)]
void RunRepackPrePass(uint id : SV_DispatchThreadID)
{
    uint baseIndex = 0;

    for (uint i = 0; i < BatchSize; i++)
    {
        ChunkDispatchKey key = ChunkInputs[i];
        uint count = TriangleCount[i];

        key.SourceCount = count;
        key.SourceOffset = 1500 * i;
        key.DestStart = baseIndex;

        // write back
        ChunkInputs[i] = key;

        baseIndex += count;
    }
    
    // Set args buffer.
    ArgsBuffer[0] = baseIndex * 3; // vertex count
    ArgsBuffer[1] = 1; // instance count
    ArgsBuffer[2] = 0; // start vertex
    ArgsBuffer[3] = 0; // start instance
    ArgsBuffer[4] = 0; // padding (this is bidirectional)
    
    // This is used for the next one.
    Args1Buffer[0] = (baseIndex + 63) / 64; // Cieling.
    Args1Buffer[1] = 1;
    Args1Buffer[2] = 1;
}

[numthreads(1, 1, 1)]
void RunRepack(uint3 id : SV_DispatchThreadID)
{
    ChunkDispatchKey chunkKey = ChunkInputs[id.x];
    
    uint srcOffset = chunkKey.SourceOffset;
    uint count = chunkKey.SourceCount;
    uint dstStart = chunkKey.DestStart;
    
    // Copy triangles for this chunk
    for (uint t = 0; t < count; t++)
    {
        TriangleDestBuffer[dstStart + t] = TriangleSourceBuffer[srcOffset + t];
    }
}

[numthreads(64, 1, 1)]
void RunDetailsPass(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;

    TriangleData tri = DetailTriangles[idx];
    ChunkDetailData d = (ChunkDetailData)0;
    
    d.Biome = GetTriangleBiomePacked(tri, tri.LodIndex);
    d.ColorA = PackFloat3(GetBiomeBlended(tri.a));
    d.ColorB = PackFloat3(GetBiomeBlended(tri.b));
    d.ColorC = PackFloat3(GetBiomeBlended(tri.c));

    DetailBuffer[idx] = d;
}
