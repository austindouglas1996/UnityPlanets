#pragma kernel Generate
#pragma kernel GenerateSurfaceMap

#include "Includes/PerlinNoise.hlsl"
#include "Includes/TriangleTable.hlsl"
#include "ChunkInput.hlsl"
#include "ChunkDensityOptions.hlsl"

StructuredBuffer<DensityMapOptions> DensityOptions;

float3 RegionCoordinate;
int _ChunkInputCount;
RWStructuredBuffer<uint> SurfaceMask;

RWStructuredBuffer<ChunkInput> ChunkInputs;
RWStructuredBuffer<float> DensityMap;

float GetFastDensityValue(DensityMapOptions options, float worldX, float worldY, float worldZ)
{
    float2 posXZ = float2(worldX, worldZ);

    // Use low-octave continent for basic terrain shape
    float base = fbm2D(posXZ * options.ContinentFrequency, 2);
    base = smoothstep(0.0, 1.0, (base + 1.0) * 0.5);

    float height = base * options.ContinentAmplitude;

    return -(worldY - height);
}

float GetDensityValue(DensityMapOptions options, float worldX, float worldY, float worldZ, int lod)
{
    float2 posXZ = float2(worldX, worldZ);
    
    int octaves;
    switch (lod)
    {
        case 0:
            octaves = 6;
            break;
        case 1:
            octaves = 4;
            break;
        case 2:
            octaves = 2;
            break;
        default:
            octaves = 1;
            break;
    }

    float2 continentPos = posXZ * options.ContinentFrequency;
    float continent = fbm2D(continentPos, 2);
    continent = smoothstep(0.0, 1.0, (continent + 1.0) * 0.5);

    float2 detailPos = (posXZ + 1234.0) * options.DetailFrequency;
    float detail = fbm2D(detailPos, lod == 1 ? 6 : octaves);

    float2 flatnessPos = (posXZ + 5555.0) * options.FlatnessFrequency;
    float flatness = fbm2D(flatnessPos, 3);
    flatness = saturate((flatness + 1.0) * 0.5);
    flatness = pow(saturate(1.0 - flatness), options.FlatnessStrength);

    float rawHeight =
        continent * options.ContinentAmplitude +
        detail * options.DetailAmplitude * flatness;

    float heightScale = max(options.ContinentAmplitude, 0.0001);
    float normalized = rawHeight / heightScale;
    float finalHeight = normalized * options.TotalHeightScale;

    float value = -(worldY - finalHeight);
    return (isnan(value) || isinf(value)) ? 0.0 : value;
}

[numthreads(8,8,8)]
void Generate(uint3 id : SV_DispatchThreadID)
{
    DensityMapOptions mOptions = DensityOptions[0];
    int chunkLogicalSize = mOptions.ChunkSize + 1;
    
    ChunkAccessInfo info = GetChunkAccess(id, chunkLogicalSize, chunkLogicalSize, chunkLogicalSize, ChunkInputs);
    if (info.mapIndex < 0)
        return;

    float3 worldPos = info.WorldPos;
    DensityMap[info.mapIndex] = GetDensityValue(mOptions, worldPos.x, worldPos.y, worldPos.z, log2(info.chunk.stepSize));
}

[numthreads(64, 1, 1)]
void GenerateSurfaceMap(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= _ChunkInputCount)
        return;

    ChunkInput chunk = ChunkInputs[index];
    DensityMapOptions mOptions = DensityOptions[0];

    float iso = mOptions.ISOLevel;
    int chunkSize = mOptions.ChunkSize + 3;
    int step = chunk.stepSize;

    bool hasAbove = false;
    bool hasBelow = false;

    // Always loop over 16³ voxels, but sample in world space using step
    for (int x = 0; x < chunkSize; x++)
        for (int y = 0; y < chunkSize; y++)
            for (int z = 0; z < chunkSize; z++)
            {
                float3 samplePos = chunk.WorldPos + float3(x * step, y * step, z * step);
                float v = GetDensityValue(mOptions, samplePos.x, samplePos.y, samplePos.z, chunk.stepSize);

                if (v >= iso)
                    hasAbove = true;
                if (v < iso)
                    hasBelow = true;

                if (hasAbove && hasBelow)
                {
                    SurfaceMask[index] = 1;
                    return;
                }
            }

    SurfaceMask[index] = 0;
}
