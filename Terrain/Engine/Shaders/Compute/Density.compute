#pragma only_renderers d3d11
#pragma target 5.0

#pragma kernel GenerateDensityMap
#pragma kernel GenerateSurfaceMask

#include "../ChunkFunctions.hlsl"
#include "../WorldNoise.hlsl"

/* Inputs */
uint Offset;
StructuredBuffer<ChunkWorkDescriptor> ChunkInputs;

/* Output */
RWStructuredBuffer<float> DensityMap;
RWStructuredBuffer<uint> SurfaceMask;

// Shared flags so any thread can “trip” the result in GetSurfaceData.
groupshared uint gHasAbove;
groupshared uint gHasBelow;

uint GetColumnIndex(ChunkCellContext context)
{
    // Each chunk owns a contiguous block of columns
    uint columnsPerChunk = CellsPerAxis * CellsPerAxis;

    uint x = context.CellCoord.x;
    uint z = context.CellCoord.z;

    return context.ChunkKeyIndex * columnsPerChunk + (z * CellsPerAxis + x);
}

[numthreads(8, 8, 1)]
void GenerateDensityMap(uint3 id : SV_DispatchThreadID)
{
    uint3 sampleSize = GetPaddedSamplesGridSize();

    ChunkCellContext col =
        GetChunkCellSamplesXZ(id, Offset, ChunkInputs);

    if (col.ChunkKeyIndex == -1) // or DensitySampleIndex == -1 if you prefer
        return;

    float height = SampleHeight(col.CellWorldPos.xz);

    // Loop Y explicitly
    for (uint y = 0; y < sampleSize.y; y++)
    {
        uint3 cellCoord = uint3(col.CellCoord.x, y, col.CellCoord.z);

        uint densityIndex =
            GetDensitySampleIndexLocal(cellCoord, col.ChunkKeyIndex, sampleSize);

        int3 logicalCoord = int3(cellCoord) - BorderSamplesPerAxis;

        float3 worldPos =
            ChunkOriginToWorld(col.Chunk) +
            float3(logicalCoord) * GetCellStep(col.Chunk.LodIndex);

        DensityMap[densityIndex] = worldPos.y - height;
    }
}

[numthreads(4, 4, 4)]
void GenerateSurfaceMask(uint3 groupId : SV_GroupID, uint3 tid : SV_GroupThreadID, uint groupIdx : SV_GroupIndex)
{
    // Load once per group (uniform)
    ChunkWorkDescriptor chunk = ChunkInputs[groupId.x];

    // Precompute invariants
    const float iso = ISOLevel;
    const int baseSize = GetBaseSamplesPerAxis();
    const int step = GetCellStep(chunk.LodIndex);

    const float3 origin = ChunkOriginToWorld(chunk.Origin, chunk.LodIndex);

    if (groupIdx == 0)
    {
        gHasAbove = 0;
        gHasBelow = 0;
    }
    GroupMemoryBarrierWithGroupSync();

    // Partition the 3D region across 4x4x4 threads
    // Each thread processes a strided subset.
    const uint done = gHasAbove & gHasBelow;
    for (uint x = tid.x; x < baseSize && !done; x += 4)
    {
        const float wx = origin.x + x * step;

        for (uint y = tid.y; y < baseSize && !done; y += 4)
        {
            const float wy = origin.y + y * step;

            for (uint z = tid.z; z < baseSize && !done; z += 4)
            {
                const float wz = origin.z + z * step;

                // Uniform branch on subvariant is fine; compiler will keep it outside inner loop
                float v = GenerateNoiseValue(float3(wx, wy, wz));

                // Set flags (branchless) and combine with atomics
                // (bool → uint: (v >= iso) ? 1 : 0)
                InterlockedOr(gHasAbove, (uint) (v >= iso));
                InterlockedOr(gHasBelow, (uint) (v < iso));
            }
        }
    }

    GroupMemoryBarrierWithGroupSync();

    // One thread writes the mask
    if (groupIdx == 0)
    {
        SurfaceMask[groupId.x] = (gHasAbove & gHasBelow) ? 1u : 0u;
    }
}
