#pragma only_renderers d3d11
#pragma target 5.0

#pragma kernel RunMarchingCubesPrePass
#pragma kernel RunMarchingCubes

#include "../ChunkFunctions.hlsl"
#include "../Includes/TransvoxelTables.hlsl"
#include "../WorldNoise.hlsl"

/* Definitions */
int CountTransvoxels(ChunkDispatchKeyInfo key);
uint BuildTransitionCase(uint face, ChunkDispatchKeyInfo key);
void MarchTransitionFace(uint face, ChunkDispatchKeyInfo key, int step, float3 world, int3 sample3);
void CreateTriangles(ChunkDispatchKeyInfo key, RegularCellData tcell, in float3 cellPos[16], in float3 cellNormal[16]);

/* Inputs */
uint Offset;
StructuredBuffer<ChunkDispatchKey> ChunkInputs;
StructuredBuffer<float> DensityMap;

/* Outputs */
RWStructuredBuffer<uint> TriangleCount;
RWStructuredBuffer<uint> TriangleCursor;
RWStructuredBuffer<TriangleData> TriangleSourceBuffer;

float3 GetNormalFast(int3 p, int keyIndex, int3 sampleSize)
{
    // Precompute strides in the flattened density buffer
    const int strideX = 1;
    const int strideY = sampleSize.x;
    const int strideZ = sampleSize.x * sampleSize.y;

    // Convert center sample position to flat index (handles borders)
    int centerIndex = GetVoxelSampleIndex(p, keyIndex, sampleSize);

    // Central differences
    float dx = DensityMap[centerIndex + strideX] - DensityMap[centerIndex - strideX];
    float dy = DensityMap[centerIndex + strideY] - DensityMap[centerIndex - strideY];
    float dz = DensityMap[centerIndex + strideZ] - DensityMap[centerIndex - strideZ];

    float3 n = -float3(dx, dy, dz);
   
    return n;
}

void CreateTriangles(ChunkDispatchKeyInfo key, RegularCellData tcell, in float3 cellPos[16], in float3 cellNormal[16])
{
    [loop]
    for (uint i = 0; i < tcell.IndicesCount; i += 3)
    {
        // Nothing here is different from 
        uint ia = TransitionCellIndices[tcell.IndicesStart + i + 0];
        uint ib = TransitionCellIndices[tcell.IndicesStart + i + 1];
        uint ic = TransitionCellIndices[tcell.IndicesStart + i + 2];

        TriangleData tri;
        tri.a = cellPos[ia];
        tri.b = cellPos[ib];
        tri.c = cellPos[ic];

        tri.NormalA = cellNormal[ia];
        tri.NormalB = cellNormal[ib];
        tri.NormalC = cellNormal[ic];

        tri.KeyIndex = key.KeyIndex;
        tri.LodIndex = 9; //key.chunk.LodIndex;

        uint next;
        InterlockedAdd(TriangleCursor[key.KeyIndex], 1, next);
        TriangleSourceBuffer[key.chunk.SourceOffset + next] = tri;
    }
}

void CountTriangles(ChunkDispatchKeyInfo key)
{
    uint totalTriangles = 0;
    uint caseCode = 0;
    int3 sample3 = GetSamplesPerChunk3();

    // Build case code
    [loop]
    for (uint i = 0; i < 8; i++)
    {
        uint3 pos = key.LocalVoxelCoord + RegularCornerOffset[i];
        float corner = DensityMap[GetVoxelSampleIndexRaw(pos, key.KeyIndex, sample3)] - ISOLevel;

        if (corner > 0.0)
            caseCode |= (1u << i);
    }

    // Empty or full cell
    if (caseCode == 0 || caseCode == 255)
        return;

    // Regular cells
    totalTriangles += RegularCellTable[RegularCellClass[caseCode] & 0x7F].TriangleCount;
    
    // Count the transvoxels triangles needed if this is an edge chunk.
    if (key.chunk.LodEdgeMask != 0)
    { 
        totalTriangles += CountTransvoxels(key);
    }

    InterlockedAdd(TriangleCount[key.KeyIndex], totalTriangles);
}

void March(ChunkDispatchKeyInfo key)
{
    uint caseCode = 0;
    float corner[8];
    float3 cornerPos[8];
    float3 cornerNormal[8];

    int step = GetCubeSizeStep(key.chunk.LodIndex);
    float3 world = ToWorld(key.chunk.Origin0);
    int3 sample3 = GetSamplesPerChunk3();

    // Case code
    for (uint i = 0; i < 8; i++)
    {
        uint3 pos = key.LocalVoxelCoord + RegularCornerOffset[i];
        corner[i] = DensityMap[GetVoxelSampleIndexRaw(pos, key.KeyIndex, sample3)];
        cornerPos[i] = (float3(pos) * step + world);
        cornerNormal[i] = GetNormalFast(pos, key.KeyIndex, sample3);
        
        if (corner[i] - ISOLevel > 0.0)
            caseCode |= (1u << i);
    }

    if (caseCode == 0 || caseCode == 255)
        return;

    uint cellClass = RegularCellClass[caseCode];
    RegularCellData cell = RegularCellTable[cellClass & 0x7F];

    float3 cellPos[16];
    float3 cellNormal[16];

    // Generate vertices
    for (uint i = 0; i < cell.VertexCount; i++)
    {
        uint packed = GetPackedVertexU16(caseCode, i);
        VertexDataUnpacked v = UnpackVertex(packed);

        float d0 = corner[v.Corner0] - ISOLevel;
        float d1 = corner[v.Corner1] - ISOLevel;

        float t = (corner[v.Corner0] - ISOLevel) * rcp(corner[v.Corner0] - corner[v.Corner1]);
        cellPos[i] = lerp(cornerPos[v.Corner0], cornerPos[v.Corner1],t);
        cellNormal[i] = normalize(lerp(cornerNormal[v.Corner0], cornerNormal[v.Corner1],t));
    }
    
    int maxVoxel = GetMaxCubeIndex();

    // Emit triangles
    for (uint i = 0; i < cell.IndicesCount; i += 3)
    {
        uint ia = RegularCellIndices[cell.IndicesStart + i + 0];
        uint ib = RegularCellIndices[cell.IndicesStart + i + 1];
        uint ic = RegularCellIndices[cell.IndicesStart + i + 2];

        TriangleData tri;
        tri.a = cellPos[ia];
        tri.b = cellPos[ib];
        tri.c = cellPos[ic];

        tri.NormalA = cellNormal[ia];
        tri.NormalB = cellNormal[ib];
        tri.NormalC = cellNormal[ic];

        tri.KeyIndex = key.KeyIndex;
        tri.LodIndex = key.chunk.LodIndex;
        
        for (int ii = 0; ii < 6; ii++)
        {
            if ((key.chunk.LodEdgeMask & (1u << ii)) == 0)
                continue;
        
            if (CubeOnFace(ii, key.LocalVoxelCoord, maxVoxel))
            {
                tri.LodIndex = 8;
            }
        }
        
        uint next;
        InterlockedAdd(TriangleCursor[key.KeyIndex], 1, next);
        TriangleSourceBuffer[key.chunk.SourceOffset + next] = tri;
    }

    if (key.chunk.LodEdgeMask == 0)
        return;
    
    [loop]
    for (uint face = 0; face < 6; face++)
    {
        if ((key.chunk.LodEdgeMask & (1u << face)) == 0)
            continue;
        
        if (!CubeOnFace(face, key.LocalVoxelCoord, maxVoxel))
            continue;

        MarchTransitionFace(face, key, step, world, sample3);
    }
}




uint BuildTransitionCase(uint face, ChunkDispatchKeyInfo key)
{
    int3 sample3 = GetSamplesPerChunk3();
    uint caseCode = 0;

    [loop]
    for (uint i = 0; i < 9; i++)
    {
        int3 samplePos = GetTransitionCornerSamplePos(face, i, key.LocalVoxelCoord);
        float d = DensityMap[GetVoxelSampleIndexRaw((uint3) samplePos, key.KeyIndex, sample3)];

        if (d < 0.0)
            caseCode |= (1u << i);
    }

    return caseCode; // 0..511
}

int CountTransvoxels(ChunkDispatchKeyInfo key)
{
    int totalTriangles = 0;
    uint maxVoxel = GetMaxCubeIndex();
    
    [loop]
    for (uint face = 0; face < 6; face++)
    {
        // Is this specific face an edge?
        if ((key.chunk.LodEdgeMask & (1u << face)) == 0)
            continue;
        
        // Confirm this specific column/row is on the edge.
        if (!CubeOnFace(face, key.LocalVoxelCoord, maxVoxel))
            continue;

        // Build transition case code for this face
        uint transitionCase = BuildTransitionCase(face, key);
        if (transitionCase == 0 || transitionCase == 511)
            continue;
        
        totalTriangles += GetTransitionCellData(transitionCase).TriangleCount;
    }
    
    return totalTriangles;
}

void MarchTransitionFace(uint face, ChunkDispatchKeyInfo key, int step, float3 world, int3 sample3)
{
    // Get the transition case.
    // if the case is 0, or 511 (limit) we have an invalid entry.
    uint transitionCase = BuildTransitionCase(face, key);  
    if (transitionCase == 0 || transitionCase == 511)
        return;
    
    // Retrieve the transition 'RegularCellData'. 
    RegularCellData tcell = GetTransitionCellData(transitionCase);
    
    // Corner data.
    float tCornerD[13];
    float3 tCornerPos[13];
    float3 tCornerN[13];
    
    // Vertex data.
    float3 cellPos[16];
    float3 cellNormal[16];

    /*
    Step #1.
        Generate corner data.
    */
    [loop]
    for (uint c = 0; c < 13; c++)
    {
        uint3 samplePos = GetTransitionCornerSamplePos(face, c, key.LocalVoxelCoord);

        tCornerD[c] = DensityMap[GetVoxelSampleIndexRaw(samplePos, key.KeyIndex, sample3)];
        tCornerPos[c] = float3(samplePos) * step + world;
        tCornerN[c] = GetNormalFast(samplePos, key.KeyIndex, sample3);
    }

    /*
    Step #2.
        Generate the vertexes data.
    */
    [loop]
    for (uint i = 0; i < tcell.VertexCount; i++)
    {
        // Unpack the vertex data. 
        uint packedIndex = GetTransitionPackedVertexU16(transitionCase, i);
        VertexDataUnpacked v = UnpackVertex(packedIndex);

        float t = (tCornerD[v.Corner0] - ISOLevel) * rcp(tCornerD[v.Corner0] - tCornerD[v.Corner1]);

        // Set the position and normal.
        cellPos[i] = lerp(tCornerPos[v.Corner0], tCornerPos[v.Corner1], t);
        cellNormal[i] = normalize(lerp(tCornerN[v.Corner0], tCornerN[v.Corner1], t));
    }
    
    /*
    Step #3.
        Generate triangles.
    */
    CreateTriangles(key, tcell, cellPos, cellNormal);
}




[numthreads(4, 4, 4)]
void RunMarchingCubesPrePass(uint3 id : SV_DispatchThreadID)
{
    ChunkDispatchKeyInfo access = GetChunkAccessCubes(id, Offset, ChunkInputs);
    CountTriangles(access);
}

[numthreads(4, 4, 4)]
void RunMarchingCubes(uint3 id : SV_DispatchThreadID)
{
    ChunkDispatchKeyInfo access = GetChunkAccessCubes(id, Offset, ChunkInputs);
    March(access);
}