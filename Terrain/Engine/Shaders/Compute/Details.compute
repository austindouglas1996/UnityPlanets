#pragma only_renderers d3d11
#pragma target 5.0

#pragma kernel RunDetailsPass

#include "../ChunkFunctions.hlsl"
#include "../Biome.hlsl"
#include "../ChunkColoring.hlsl"

/* Inputs */
StructuredBuffer<TriangleData> DetailTriangles;

/* Outputs */
RWStructuredBuffer<ChunkDetailData> DetailBuffer;

[numthreads(64, 1, 1)]
void RunDetailsPass(uint3 id : SV_DispatchThreadID)
{
    TriangleData tri = DetailTriangles[id.x];
    ChunkDetailData d = (ChunkDetailData) 0;
    
    uint a = SampleTerrainClass(tri.a);
    uint b = SampleTerrainClass(tri.b);
    uint c = SampleTerrainClass(tri.c);
    
    d.Biome = PackBiomeIndices(a, b, c, tri.LodIndex);
    
    d.ColorA = Biomes[a].MidLight; //SampleBiomeBlend(Biomes[a], tri.a);
    d.ColorB = Biomes[b].MidLight; //SampleBiomeBlend(Biomes[a], tri.a);
    d.ColorC = Biomes[c].MidLight; //SampleBiomeBlend(Biomes[a], tri.a);

    DetailBuffer[id.x] = d;
}